#!/usr/bin/env python3
"""Locate, load, or lint the personal learner profile.

The global profile lives at config_dir()/learning-profile.md. It is generated by
the profile-init skill and loaded at session start via `learn-profile show`,
which doubles as the missing-profile guard: nonzero exit + a stderr sentinel.

`learn-profile check` is a tolerant, read-only lint that profile-init and profile-update run
after writing. The profile is prose, so it warns rather than fails: missing sections, edges
without a usable level or depth note, slugs `learn-log` would reject, learning languages no
edge covers, and progress markers that will go stale.

Exit codes: 0 ok, 1 no profile (for `show` and `check`) or warnings under `check --strict`.
"""

import argparse
import re
import sys

from _toolkit import config_dir, load_vocab

SENTINEL = "NO_PROFILE"

LEVELS = {"novice", "proficient", "expert"}
ROLES = {"learning", "working", "analogy"}
# Headings the modes rely on, matched as case-insensitive prefixes.
REQUIRED_SECTIONS = ["Who you are teaching", "Growth edges", "Languages in scope", "Preferences"]
# Display names that do not lowercase to their logging slug.
LANG_ALIASES = {"c++": "cpp", "c#": "csharp", "f#": "fsharp", "golang": "go"}

SLUG_RE = re.compile(r"^[a-z0-9]+(-[a-z0-9]+)*$")
EDGE_RE = re.compile(r"^- \*\*`?([^`*]+?)`?\*\*")
LANG_LINE_RE = re.compile(r"^- `([^`]+)`(?:\s*\(([^)]+)\))?")
# Progress markers are wrong within weeks. A year or year-month on the same line counts as dated.
PROGRESS_RE = re.compile(r"\b(chapters?\s+\d+|just\s+start(?:ed|ing)|this\s+(?:week|month)|"
                         r"right\s+now|at\s+the\s+moment)\b", re.IGNORECASE)
DATED_RE = re.compile(r"\b(?:19|20)\d\d(?:-\d\d)?\b")


def profile_path():
    return config_dir() / "learning-profile.md"


def require_profile():
    path = profile_path()
    if not path.exists():
        print(SENTINEL, file=sys.stderr)
        print(f"no profile at {path}; run the learning:profile-init skill to create one",
              file=sys.stderr)
        sys.exit(1)
    return path


def cmd_path(args):
    path = profile_path()
    if args.ensure_dir:
        path.parent.mkdir(parents=True, exist_ok=True)
    print(path)


def cmd_show(args):
    sys.stdout.write(require_profile().read_text(encoding="utf-8"))


def split_sections(text: str) -> dict:
    """'## ' heading (lowercased) -> body lines."""
    sections, current = {}, None
    for line in text.splitlines():
        m = re.match(r"^##\s+(.+?)\s*$", line)
        if m:
            current = m.group(1).lower()
            sections[current] = []
        elif current is not None:
            sections[current].append(line)
    return sections


def section(sections: dict, name: str):
    for heading, body in sections.items():
        if heading.startswith(name.lower()):
            return body
    return None


def blocks(lines: list) -> list:
    """Top-level bullets joined with their indented continuation lines; other text lines alone."""
    out = []
    for line in lines:
        stripped = line.strip()
        if not stripped or stripped.startswith((">", "<!--")):
            continue
        if line.startswith((" ", "\t")) and out and out[-1].startswith("- "):
            out[-1] += " " + stripped
        else:
            out.append(stripped)
    return out


def names_language(text: str, name: str, slug: str) -> bool:
    """Whether prose names a language by its display name.

    Case-sensitive, and never by a bare slug: slugs such as `go` or `r` are ordinary words, so
    only a backticked slug (checked by the caller) or a distinct display name ("Go") counts.
    """
    if name == slug:
        return False
    return re.search(rf"(?<![\w+#]){re.escape(name)}(?![\w+#])", text) is not None


def parse_edges(lines: list, warn) -> list:
    edges = []
    for block in blocks(lines):
        m = EDGE_RE.match(block)
        if not m:
            continue
        slug = m.group(1).strip()
        edges.append((slug, block))
        level = re.search(r"\bLevel:\s*\**\s*([A-Za-z-]+)", block)
        if not level:
            warn(f"edge `{slug}` has no `Level:`")
        elif level.group(1).lower() not in LEVELS:
            warn(f"edge `{slug}` has unknown level `{level.group(1)}` "
                 f"(novice | proficient | expert)")
        if not re.search(r"\bDepth:", block):
            warn(f"edge `{slug}` has no `Depth:` note")
    return edges


def parse_languages(lines: list, warn) -> list:
    """Accept the one-line-per-language format and the older flat or classified lists."""
    langs, legacy = [], False
    for block in blocks(lines):
        m = LANG_LINE_RE.match(block)
        if m:
            slug = m.group(1).strip()
            role = re.search(r"\brole:\s*([A-Za-z-]+)", block)
            if not role:
                warn(f"language `{slug}` has no role (learning | working | analogy)")
            elif role.group(1).lower() not in ROLES:
                warn(f"language `{slug}` has unknown role `{role.group(1)}` "
                     f"(learning | working | analogy)")
            if not re.search(r"\bProficiency:", block, re.IGNORECASE):
                warn(f"language `{slug}` has no `Proficiency:`")
            langs.append({"slug": slug, "name": (m.group(2) or slug).strip(),
                          "role": role.group(1).lower() if role else None})
            continue

        legacy = True
        text = (block[2:] if block.startswith("- ") else block).replace("**", "")
        label, _, items = text.partition(":") if ":" in text else ("", "", text)
        role = ("learning" if re.search(r"learn|primary", label, re.IGNORECASE) else
                "analogy" if re.search(r"analog|reference", label, re.IGNORECASE) else
                "working" if re.search(r"working", label, re.IGNORECASE) else None)
        for item in re.split(r",|;|/|\band\b", re.sub(r"\([^)]*\)", "", items)):
            name = re.split(r"\s[—–-]\s", item)[0].strip(" .`*")
            if not name or len(name.split()) > 2:
                continue  # prose, not a language name
            slug = LANG_ALIASES.get(name.lower(), name.lower())
            if not SLUG_RE.match(slug):
                warn(f"cannot map language `{name}` to a slug")
                continue
            langs.append({"slug": slug, "name": name, "role": role})
    if legacy:
        warn("languages are not in the one-line format "
             "(- `slug` (Name) — role: learning | working | analogy. Proficiency: …); "
             "learning:profile-update can migrate them")
    return langs


def check(text: str, vocab: dict) -> list:
    warnings = []
    warn = warnings.append
    sections = split_sections(text)

    for name in REQUIRED_SECTIONS:
        if section(sections, name) is None:
            warn(f"missing section: ## {name}")

    edges = parse_edges(section(sections, "Growth edges") or [], warn)
    if section(sections, "Growth edges") is not None and not edges:
        warn("no growth edges found (expected bullets like - **`edge-slug`** — scope: …)")
    langs = parse_languages(section(sections, "Languages in scope") or [], warn)

    for slug, _ in edges:
        if not SLUG_RE.match(slug):
            warn(f"edge `{slug}` is not a kebab-case slug")
        elif slug not in vocab["edges"]:
            warn(f"edge `{slug}` is not in the vocabulary, so learn-log will reject it "
                 f"(learn-vocab add --edges {slug})")
    for slug in dict.fromkeys(lang["slug"] for lang in langs):
        if not SLUG_RE.match(slug):
            warn(f"language `{slug}` is not a kebab-case slug")
        elif slug not in vocab["langs"]:
            warn(f"lang `{slug}` is not in the vocabulary, so learn-log will reject it "
                 f"(learn-vocab add --langs {slug})")

    edge_text = "\n".join(block for _, block in edges)
    for lang in langs:
        if lang["role"] != "learning":
            continue
        covered = (any(slug.startswith(lang["slug"] + "-") for slug, _ in edges)
                   or f"`{lang['slug']}`" in edge_text
                   or names_language(edge_text, lang["name"], lang["slug"]))
        if not covered:
            warn(f"`{lang['slug']}` is role: learning but no growth edge covers it; outside a "
                 f"growth edge the tutor is terse (add a `{lang['slug']}-fundamentals` edge, or "
                 f"say in an edge's depth note how its material is pitched)")

    for n, line in enumerate(text.splitlines(), 1):
        marker = PROGRESS_RE.search(line)
        if marker and not DATED_RE.search(line):
            warn(f"line {n}: undated progress marker \"{marker.group(0)}\" will go stale; "
                 f"date it (as of YYYY-MM) or phrase it as evidence the log can show")
    return warnings


def cmd_check(args):
    path = require_profile()
    warnings = check(path.read_text(encoding="utf-8"), load_vocab(seed=False))
    print(f"checked {path}")
    for w in warnings:
        print(f"warning: {w}")
    print(f"{len(warnings)} warning(s)" if warnings else "profile ok: no warnings")
    if args.strict and warnings:
        sys.exit(1)


def main():
    p = argparse.ArgumentParser(
        prog="learn-profile", description="Locate, load, or lint the learner profile.")
    sub = p.add_subparsers(dest="cmd", required=True)

    pp = sub.add_parser("path", help="print the profile path")
    pp.add_argument("--ensure-dir", action="store_true",
                    help="create the config dir if absent")
    pp.set_defaults(func=cmd_path)

    ps = sub.add_parser("show", help="print the profile, or exit 1 if none exists")
    ps.set_defaults(func=cmd_show)

    pc = sub.add_parser("check", help="read-only lint; warnings only")
    pc.add_argument("--strict", action="store_true", help="exit 1 when there are warnings")
    pc.set_defaults(func=cmd_check)

    args = p.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
