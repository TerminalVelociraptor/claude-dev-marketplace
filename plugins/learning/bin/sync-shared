#!/usr/bin/env python3
"""Splice the shared core into each SKILL.md between marker comments.

Why build-time instead of runtime:

Claude Code's dynamic context injection (```! blocks) is permission-checked, and the check
matches the whole block as one opaque string, so no `allowed-tools` rule can satisfy it. In
default permission mode the injection fails and the turn is silently discarded -- empty
output, zero turns, no error shown to the user. Runtime `Read` fails more honestly but still
depends on the model choosing to read, and on reads outside the project being permitted.

Splicing at build time gives what runtime injection promised -- the shared text is guaranteed
present, byte for byte, with `shared/` remaining the single place to edit -- while removing
the runtime dependency entirely.

Usage:
  sync-shared            splice shared content into every SKILL.md
  sync-shared --check    exit 1 if any skill is out of date (for CI or a pre-commit hook)
"""

import argparse
import re
import sys
from pathlib import Path

PLUGIN_ROOT = Path(__file__).resolve().parent.parent
SHARED = PLUGIN_ROOT / "shared"
SKILLS = PLUGIN_ROOT / "skills"

BEGIN = "<!-- BEGIN shared:{name} -- generated by bin/sync-shared, do not edit here -->"
END = "<!-- END shared:{name} -->"
BLOCK_RE = re.compile(
    r"<!-- BEGIN shared:(?P<name>[a-z0-9-]+) -- generated by bin/sync-shared, do not edit here -->"
    r".*?"
    r"<!-- END shared:(?P=name) -->",
    re.DOTALL,
)


def render(name: str) -> str:
    src = SHARED / f"{name}.md"
    if not src.exists():
        print(f"sync-shared: missing {src}", file=sys.stderr)
        sys.exit(2)
    body = src.read_text(encoding="utf-8").rstrip("\n")
    return f"{BEGIN.format(name=name)}\n{body}\n{END.format(name=name)}"


def sync_file(path: Path) -> str:
    """Return the updated text for one SKILL.md."""
    text = path.read_text(encoding="utf-8")

    def repl(m):
        return render(m.group("name"))

    return BLOCK_RE.sub(repl, text)


def main() -> None:
    ap = argparse.ArgumentParser(prog="sync-shared", description=__doc__.split("\n")[0])
    ap.add_argument("--check", action="store_true",
                    help="report drift and exit nonzero instead of writing")
    args = ap.parse_args()

    skill_files = sorted(SKILLS.glob("*/SKILL.md"))
    if not skill_files:
        print(f"sync-shared: no skills found under {SKILLS}", file=sys.stderr)
        sys.exit(2)

    stale, updated = [], []
    for path in skill_files:
        original = path.read_text(encoding="utf-8")
        if not BLOCK_RE.search(original):
            continue  # a skill that does not embed the shared core, such as `flag`
        new = sync_file(path)
        if new == original:
            continue
        if args.check:
            stale.append(path.relative_to(PLUGIN_ROOT))
        else:
            path.write_text(new, encoding="utf-8")
            updated.append(path.relative_to(PLUGIN_ROOT))

    if args.check:
        if stale:
            print("shared core is out of date in:")
            for p in stale:
                print(f"  {p}")
            print("\nrun bin/sync-shared to update")
            sys.exit(1)
        print("all skills are up to date with shared/")
        return

    if updated:
        for p in updated:
            print(f"updated {p}")
    else:
        print("already up to date")


if __name__ == "__main__":
    main()
