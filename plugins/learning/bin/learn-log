#!/usr/bin/env python3
"""Append one validated entry to the global learning log.

The log is append-only JSONL, one object per line, optimised for cheap machine reading
(tail/grep, no full-file parse). This script is the only supported writer. `type`/`signal` are fixed here (they are bound to
learn-queue logic); `edge`/`lang` are validated against the living vocabulary in vocab.json
(managed by bin/learn-vocab); `skill` is derived from the skills directory. A typo is rejected
so it can never silently corrupt the queue that drives spaced repetition.

Exit codes: 0 ok, 2 validation error.
"""

import argparse
import json
import os
import re
import sys
from datetime import datetime, timezone
from pathlib import Path

from _toolkit import config_dir, load_vocab, plugin_skills

# `type`/`signal` are FIXED here because learn-queue scheduling keys off these exact values.
# `edge`/`lang`/`skill` are NOT fixed: edge/lang come from the living vocab.json (see
# bin/learn-vocab) and skill is derived from the skills directory, both resolved at runtime
# in main().
TYPES = {
    "taught",          # concept taught in context
    "skipped",         # deep-dive offered and declined, or deliberately deferred
    "edge-confirmed",  # a growth-edge gap confirmed real
    "calibration",     # signal that the assumed baseline may be wrong
    "to-cover",        # queued for later study
    "escape",          # escape valve fired
    "hit",             # predicted/answered correctly
    "miss",            # predicted/answered wrongly
    "graduated",       # retired from active rotation
    "reactivated",     # a graduated concept failed and re-entered rotation
    "self-assessment", # self-assessment vs reality delta
}

# `signal` is scoped per type: a signal only means something for the types that define it,
# and those types require one when written. Entries logged before that rule are still read.
SIGNALS = {
    # below-level: the explanation was pitched below them. above-level: pitched above them.
    "calibration": {"already-known", "declined-deepdive", "below-level", "above-level"},
    "self-assessment": {"found-self", "missed-self", "overconfident", "underconfident"},
}

# Stable kebab-case slug in one global namespace, so the same concept means the same thing
# in every repo. That shared namespace is what makes cross-project spacing possible.
CONCEPT_RE = re.compile(r"^[a-z0-9]+(-[a-z0-9]+)*$")
MAX_CONCEPT_LEN = 64


def log_path() -> Path:
    return config_dir() / "learning-log.jsonl"


def concept_edges() -> dict:
    """Concept -> non-`none` edges it has been logged under.

    Membership nudges reuse over coining near-duplicates; the edges catch a concept drifting
    to an edge it has never carried, which is usually a mislabel.
    """
    path = log_path()
    if not path.exists():
        return {}
    seen = {}
    with path.open(encoding="utf-8") as fh:
        for line in fh:
            line = line.strip()
            if not line:
                continue
            try:
                entry = json.loads(line)
            except json.JSONDecodeError:
                continue  # tolerate a damaged line rather than refusing to log
            concept = entry.get("concept")
            if not concept:
                continue
            edges = seen.setdefault(concept, set())
            if entry.get("edge") and entry["edge"] != "none":
                edges.add(entry["edge"])
    return seen


def fail(msg: str) -> "typing.NoReturn":  # noqa: F821
    print(f"learn-log: {msg}", file=sys.stderr)
    sys.exit(2)


def detect_project() -> str:
    """Name the current repo so entries stay attributable and sliceable per-project."""
    cwd = Path.cwd()
    for d in (cwd, *cwd.parents):
        if (d / ".git").exists():
            return d.name
    return cwd.name


def main() -> None:
    vocab = load_vocab()
    edges = vocab["edges"] | {"none"}
    langs = vocab["langs"] | {"none"}
    skills = plugin_skills() | {"none"}

    p = argparse.ArgumentParser(
        prog="learn-log",
        description="Append a validated entry to the global learning log.",
    )
    # --type/--concept are enforced after the --help-signals check, so that flag works alone.
    p.add_argument("--type", help=f"required; one of: {' '.join(sorted(TYPES))}")
    p.add_argument("--concept", help="required; stable kebab-case slug, global namespace")
    p.add_argument("--edge", default="none", help=f"one of: {' '.join(sorted(edges))}")
    p.add_argument("--lang", default="none", help=f"one of: {' '.join(sorted(langs))}")
    p.add_argument("--skill", default="none", help=f"one of: {' '.join(sorted(skills))}")
    p.add_argument("--signal", default=None,
                   help=f"required for {'/'.join(sorted(SIGNALS))}; see --help-signals")
    p.add_argument("--project", default=None, help="repo name (auto-detected if omitted)")
    p.add_argument("--note", default=None, help="short free text, for humans")
    p.add_argument("--session", default=None, help="session id, for grouping entries")
    p.add_argument("--dry-run", action="store_true", help="validate and print, do not append")
    p.add_argument("--help-signals", action="store_true", help="print the signal vocabulary and exit")
    args = p.parse_args()

    if args.help_signals:
        for t, vals in SIGNALS.items():
            print(f"{t}: {' '.join(sorted(vals))}")
        sys.exit(0)

    missing = [flag for flag, val in (("--type", args.type), ("--concept", args.concept))
               if val is None]
    if missing:
        p.error(f"the following arguments are required: {', '.join(missing)}")

    if args.type not in TYPES:
        fail(f"invalid --type {args.type!r}. Valid: {' '.join(sorted(TYPES))}")
    if args.edge not in edges:
        fail(f"invalid --edge {args.edge!r}. Valid: {' '.join(sorted(edges))}\n"
             f"       add it with: bin/learn-vocab add --edges {args.edge}")
    if args.lang not in langs:
        fail(f"invalid --lang {args.lang!r}. Valid: {' '.join(sorted(langs))}\n"
             f"       add it with: bin/learn-vocab add --langs {args.lang}")
    if args.skill not in skills:
        fail(f"invalid --skill {args.skill!r}. Valid: {' '.join(sorted(skills))}")

    concept = args.concept.strip()
    if not CONCEPT_RE.match(concept):
        fail(f"invalid --concept {concept!r}: must be kebab-case, e.g. 'false-sharing'")
    if len(concept) > MAX_CONCEPT_LEN:
        fail(f"--concept too long ({len(concept)} > {MAX_CONCEPT_LEN})")

    allowed = SIGNALS.get(args.type)
    if args.signal is None and allowed is not None:
        fail(f"--signal is required for --type {args.type!r}. Valid: {' '.join(sorted(allowed))}")
    if args.signal is not None:
        if allowed is None:
            fail(f"--signal is not meaningful for --type {args.type!r}; omit it")
        if args.signal not in allowed:
            fail(f"invalid --signal {args.signal!r} for type {args.type!r}. "
                 f"Valid: {' '.join(sorted(allowed))}")

    entry = {
        "ts": datetime.now(timezone.utc).isoformat(timespec="seconds").replace("+00:00", "Z"),
        "type": args.type,
        "concept": concept,
        "edge": args.edge,
        "lang": args.lang,
        "project": args.project or detect_project(),
        "skill": args.skill,
    }
    if args.signal:
        entry["signal"] = args.signal
    if args.note:
        entry["note"] = args.note
    if args.session:
        entry["session"] = args.session

    # separators=(",",":") keeps lines compact; the log is optimised for machines, not eyeballs.
    line = json.dumps(entry, ensure_ascii=False, separators=(",", ":"))

    if args.dry_run:
        print(line)
        return

    path = log_path()
    history = concept_edges()
    data = (line + "\n").encode("utf-8")
    try:
        path.parent.mkdir(parents=True, exist_ok=True)
        # One write(2) on an O_APPEND descriptor: the kernel seeks to end-of-file and writes in
        # one step, so records from concurrent sessions land whole, one after another.
        fd = os.open(path, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o644)
        try:
            written = os.write(fd, data)
            closed_off = True
            if written != len(data):
                # Never leave a partial record without its newline: the next append would run
                # into it and both lines would be unparseable. Ended here, only the fragment is.
                try:
                    os.write(fd, b"\n")
                except OSError:
                    closed_off = False
        finally:
            os.close(fd)
    except OSError as exc:
        fail(f"could not write {path}: {exc}")
    if written != len(data):
        state = ("the fragment was ended with a newline, so readers skip just that line"
                 if closed_off else "the fragment could not be ended with a newline; check the log's last line")
        fail(f"short write to {path} ({written} of {len(data)} bytes): the entry was NOT logged and "
             f"{state}. Re-run once the cause (such as a full disk) is fixed.")

    suffix = "  [new concept]" if concept not in history else ""
    print(f"logged {args.type}/{concept}{suffix}")
    if concept in history and args.edge != "none" and args.edge not in history[concept]:
        before = " ".join(sorted(history[concept])) or "none"
        print(f"note: first time {concept} is logged under edge {args.edge} "
              f"(before: {before}); fine if intended, otherwise reuse its existing edge")


if __name__ == "__main__":
    main()
