#!/usr/bin/env python3
"""Append one validated entry to the global learning log.

The log is append-only JSONL, one object per line, optimised for cheap machine reading
(tail/grep, no full-file parse). This script is the only supported writer: it enforces the
closed vocabularies pinned in shared/learning-profile.md so a typo can never silently
corrupt the queue that drives spaced repetition.

Exit codes: 0 ok, 2 validation error.
"""

import argparse
import json
import os
import re
import sys
from datetime import datetime, timezone
from pathlib import Path

# Closed vocabularies. Keep these SMALL and FIXED; they are mirrored in
# shared/learning-profile.md and must be changed in both places together.
TYPES = {
    "taught",          # concept taught in context
    "skipped",         # deep-dive offered and declined, or deliberately deferred
    "edge-confirmed",  # a growth-edge gap confirmed real
    "calibration",     # signal that the assumed baseline may be wrong
    "to-cover",        # queued for later study
    "escape",          # escape valve fired
    "hit",             # predicted/answered correctly
    "miss",            # predicted/answered wrongly
    "graduated",       # retired from active rotation
    "reactivated",     # a graduated concept failed and re-entered rotation
    "self-assessment", # self-assessment vs reality delta
}

EDGES = {"internals", "hpc", "concurrency", "none"}
LANGS = {"c", "cpp", "python", "java", "none"}
SKILLS = {"guided", "pair", "drill", "flag", "none"}

# `signal` is scoped per type: a signal only means something for the types that define it.
SIGNALS = {
    "calibration": {"already-known", "declined-deepdive", "below-level"},
    "self-assessment": {"found-self", "missed-self", "overconfident", "underconfident"},
}

# Stable kebab-case slug in one global namespace, so the same concept means the same thing
# in every repo. That shared namespace is what makes cross-project spacing possible.
CONCEPT_RE = re.compile(r"^[a-z0-9]+(-[a-z0-9]+)*$")
MAX_CONCEPT_LEN = 64


def log_dir() -> Path:
    """Resolve the single global log directory all skills must agree on."""
    base = os.environ.get("XDG_CONFIG_HOME") or os.path.join(os.path.expanduser("~"), ".config")
    return Path(base) / "learning-toolkit"


def log_path() -> Path:
    return log_dir() / "learning-log.jsonl"


def known_concepts() -> set:
    """Concepts already in the log. Used to nudge reuse over coining near-duplicates."""
    path = log_path()
    if not path.exists():
        return set()
    seen = set()
    with path.open(encoding="utf-8") as fh:
        for line in fh:
            line = line.strip()
            if not line:
                continue
            try:
                concept = json.loads(line).get("concept")
            except json.JSONDecodeError:
                continue  # tolerate a damaged line rather than refusing to log
            if concept:
                seen.add(concept)
    return seen


def fail(msg: str) -> "typing.NoReturn":  # noqa: F821
    print(f"learn-log: {msg}", file=sys.stderr)
    sys.exit(2)


def detect_project() -> str:
    """Name the current repo so entries stay attributable and sliceable per-project."""
    cwd = Path.cwd()
    for d in (cwd, *cwd.parents):
        if (d / ".git").exists():
            return d.name
    return cwd.name


def main() -> None:
    p = argparse.ArgumentParser(
        prog="learn-log",
        description="Append a validated entry to the global learning log.",
    )
    p.add_argument("--type", required=True, help=f"one of: {' '.join(sorted(TYPES))}")
    p.add_argument("--concept", required=True, help="stable kebab-case slug, global namespace")
    p.add_argument("--edge", default="none", help=f"one of: {' '.join(sorted(EDGES))}")
    p.add_argument("--lang", default="none", help=f"one of: {' '.join(sorted(LANGS))}")
    p.add_argument("--skill", default="none", help=f"one of: {' '.join(sorted(SKILLS))}")
    p.add_argument("--signal", default=None, help="type-scoped; see --help-signals")
    p.add_argument("--project", default=None, help="repo name (auto-detected if omitted)")
    p.add_argument("--note", default=None, help="short free text, for humans")
    p.add_argument("--session", default=None, help="session id, for grouping entries")
    p.add_argument("--dry-run", action="store_true", help="validate and print, do not append")
    p.add_argument("--help-signals", action="store_true", help="print the signal vocabulary and exit")
    args = p.parse_args()

    if args.help_signals:
        for t, vals in SIGNALS.items():
            print(f"{t}: {' '.join(sorted(vals))}")
        sys.exit(0)

    if args.type not in TYPES:
        fail(f"invalid --type {args.type!r}. Valid: {' '.join(sorted(TYPES))}")
    if args.edge not in EDGES:
        fail(f"invalid --edge {args.edge!r}. Valid: {' '.join(sorted(EDGES))}")
    if args.lang not in LANGS:
        fail(f"invalid --lang {args.lang!r}. Valid: {' '.join(sorted(LANGS))}")
    if args.skill not in SKILLS:
        fail(f"invalid --skill {args.skill!r}. Valid: {' '.join(sorted(SKILLS))}")

    concept = args.concept.strip()
    if not CONCEPT_RE.match(concept):
        fail(f"invalid --concept {concept!r}: must be kebab-case, e.g. 'false-sharing'")
    if len(concept) > MAX_CONCEPT_LEN:
        fail(f"--concept too long ({len(concept)} > {MAX_CONCEPT_LEN})")

    if args.signal is not None:
        allowed = SIGNALS.get(args.type)
        if allowed is None:
            fail(f"--signal is not meaningful for --type {args.type!r}; omit it")
        if args.signal not in allowed:
            fail(f"invalid --signal {args.signal!r} for type {args.type!r}. "
                 f"Valid: {' '.join(sorted(allowed))}")

    entry = {
        "ts": datetime.now(timezone.utc).isoformat(timespec="seconds").replace("+00:00", "Z"),
        "type": args.type,
        "concept": concept,
        "edge": args.edge,
        "lang": args.lang,
        "project": args.project or detect_project(),
        "skill": args.skill,
    }
    if args.signal:
        entry["signal"] = args.signal
    if args.note:
        entry["note"] = args.note
    if args.session:
        entry["session"] = args.session

    # separators=(",",":") keeps lines compact; the log is optimised for machines, not eyeballs.
    line = json.dumps(entry, ensure_ascii=False, separators=(",", ":"))

    if args.dry_run:
        print(line)
        return

    path = log_path()
    is_new_concept = concept not in known_concepts()
    try:
        path.parent.mkdir(parents=True, exist_ok=True)
        # Append mode with a trailing newline per record keeps the file valid JSONL even if
        # two writers interleave; single small writes are atomic enough in practice here.
        with path.open("a", encoding="utf-8") as fh:
            fh.write(line + "\n")
    except OSError as exc:
        fail(f"could not write {path}: {exc}")

    suffix = "  [new concept]" if is_new_concept else ""
    print(f"logged {args.type}/{concept}{suffix}")


if __name__ == "__main__":
    main()
