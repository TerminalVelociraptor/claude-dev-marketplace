#!/usr/bin/env python3
"""Record and summarize the token usage of the handoff skill's cold read.

A subagent's completion notice reports one token figure, but that is roughly the size of its last
request, not what the run used. The subagent's transcript has usage for every request, so this
reads the transcript instead. It keeps the last line per message id (earlier streaming lines can
repeat or zero the usage), sums each token type, prints the line the skill puts in its report, and
appends one JSON record to a log for later review.

    cold-read-usage TRANSCRIPT [--agent-id ID] --brief PATH --filled N --undecided M
    cold-read-usage --agent-id ID --brief PATH --filled N --undecided M
    cold-read-usage --summary

With --agent-id and no usable transcript path, the transcript is looked up under
~/.claude/projects/*/*/subagents/.

Exit status: 0 recorded, 1 usage unavailable (the report line and a record are still written),
2 bad arguments.
"""

import argparse
import json
import re
import statistics
import sys
from datetime import datetime, timezone
from pathlib import Path

DEFAULT_LOG = Path.home() / ".claude" / "handoffs" / "cold-read-usage.jsonl"
DEFAULT_PROJECTS = Path.home() / ".claude" / "projects"

# Record field -> transcript usage field.
TOKEN_FIELDS = {
    "input": "input_tokens",
    "cache_write": "cache_creation_input_tokens",
    "cache_read": "cache_read_input_tokens",
    "output": "output_tokens",
}
SUMMARY_FIELDS = ["total", "cache_write", "cache_read", "output", "input", "duration_s", "brief_lines"]


def parse_time(value):
    try:
        return datetime.fromisoformat(value.replace("Z", "+00:00"))
    except (AttributeError, ValueError):
        return None


def short(number):
    return f"{number / 1000:.1f}k" if number >= 1000 else f"{number:.0f}"


def duration(seconds):
    if seconds is None:
        return "duration unknown"
    minutes, secs = divmod(round(seconds), 60)
    return f"{minutes}m{secs:02d}s" if minutes else f"{secs}s"


def find_transcript(agent_id, projects_dir):
    if not re.fullmatch(r"[A-Za-z0-9_-]+", agent_id):
        return None
    matches = sorted(projects_dir.glob(f"*/*/subagents/agent-{agent_id}.jsonl"),
                     key=lambda path: path.stat().st_mtime)
    return matches[-1] if matches else None


def read_usage(transcript):
    messages = {}
    times = []
    agent_id = None
    with open(transcript) as handle:
        for line in handle:
            try:
                entry = json.loads(line)
            except json.JSONDecodeError:
                continue
            if not isinstance(entry, dict):
                continue
            agent_id = agent_id or entry.get("agentId")
            if moment := parse_time(entry.get("timestamp")):
                times.append(moment)
            message = entry.get("message")
            if (not isinstance(message, dict) or not message.get("usage")
                    or message.get("model") == "<synthetic>"):
                continue
            messages[message.get("id") or entry.get("requestId") or entry.get("uuid")] = message

    usage = {field: 0 for field in TOKEN_FIELDS}
    usage.update(cache_write_5m=0, cache_write_1h=0)
    models = []
    for message in messages.values():
        counts = message["usage"]
        for field, source in TOKEN_FIELDS.items():
            usage[field] += counts.get(source) or 0
        split = counts.get("cache_creation") or {}
        usage["cache_write_5m"] += split.get("ephemeral_5m_input_tokens") or 0
        usage["cache_write_1h"] += split.get("ephemeral_1h_input_tokens") or 0
        if message.get("model") and message["model"] not in models:
            models.append(message["model"])
    usage["total"] = sum(usage[field] for field in TOKEN_FIELDS)
    usage["requests"] = len(messages)
    usage["model"] = ", ".join(models) or None
    usage["duration_s"] = round((max(times) - min(times)).total_seconds(), 1) if times else None
    usage["agent_id"] = agent_id
    return usage


def record_run(args):
    transcript = args.transcript
    if (transcript is None or not transcript.exists()) and args.agent_id:
        transcript = find_transcript(args.agent_id, args.projects_dir) or transcript

    brief_lines = None
    if args.brief.is_file():
        brief_lines = len(args.brief.read_text(errors="replace").splitlines())
    record = {
        "logged_at": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
        "brief": str(args.brief),
        "brief_lines": brief_lines,
        "transcript": str(transcript) if transcript else None,
        "gaps_filled": args.filled,
        "gaps_undecided": args.undecided,
    }

    error = None
    if transcript is None:
        error = f"no transcript found for agent {args.agent_id}"
    elif not transcript.exists():
        error = f"transcript not found: {transcript}"
    else:
        try:
            record.update(read_usage(transcript))
        except OSError as exc:
            error = f"could not read transcript: {exc}"
        else:
            if record["requests"] == 0:
                error = f"no usage in transcript: {transcript}"
    record["agent_id"] = record.get("agent_id") or args.agent_id
    record["error"] = error

    logged = f" Logged to {args.log}."
    try:
        args.log.parent.mkdir(parents=True, exist_ok=True)
        with args.log.open("a") as handle:
            handle.write(json.dumps(record) + "\n")
    except OSError as exc:
        logged = f" Not logged ({exc})."
        error = error or "log write failed"

    gaps = f"Cold read: {args.filled} gaps filled, {args.undecided} added as undecided."
    if record["error"]:
        print(f"{gaps} Usage unavailable ({record['error']}).{logged}")
        return 1
    requests = record["requests"]
    print(
        f"{gaps} Usage: {short(record['total'])} tokens over {requests} "
        f"request{'s' if requests != 1 else ''} ({short(record['cache_write'])} cache write, "
        f"{short(record['cache_read'])} cache read, {short(record['output'])} output, "
        f"{short(record['input'])} uncached input), {record['model']}, "
        f"{duration(record['duration_s'])}.{logged}"
    )
    return 1 if error else 0


def summarize(log):
    if not log.exists():
        print(f"No cold reads logged yet ({log}).")
        return 0
    records = []
    for line in log.read_text().splitlines():
        try:
            records.append(json.loads(line))
        except json.JSONDecodeError:
            continue
    usable = [record for record in records if not record.get("error")]
    print(f"{len(records)} cold read(s) logged in {log}; {len(records) - len(usable)} without usage.")
    if not usable:
        return 0

    formats = {"duration_s": duration, "brief_lines": lambda value: f"{value:.0f}"}
    print(f"{'':<13}{'median':>10}{'max':>10}")
    for field in SUMMARY_FIELDS:
        values = [record[field] for record in usable if isinstance(record.get(field), (int, float))]
        if values:
            show = formats.get(field, short)
            print(f"{field:<13}{show(statistics.median(values)):>10}{show(max(values)):>10}")
    latest = usable[-1]
    print(f"Latest: {latest.get('logged_at')}, {short(latest.get('total', 0))} tokens, "
          f"brief {latest.get('brief_lines')} lines, {latest.get('brief')}")
    return 0


def main(argv=None):
    parser = argparse.ArgumentParser(description="Record or summarize cold-read token usage.")
    parser.add_argument("transcript", nargs="?", type=Path,
                        help="the cold-read subagent's transcript (the Agent result's output_file)")
    parser.add_argument("--agent-id", help="the subagent's id; used to find the transcript if needed")
    parser.add_argument("--brief", type=Path, help="the brief that was read")
    parser.add_argument("--filled", type=int, help="gaps filled after the cold read")
    parser.add_argument("--undecided", type=int, help="gaps added as undecided")
    parser.add_argument("--summary", action="store_true", help="summarize the log instead of recording")
    parser.add_argument("--log", type=Path, default=DEFAULT_LOG, help=f"log file (default: {DEFAULT_LOG})")
    parser.add_argument("--projects-dir", type=Path, default=DEFAULT_PROJECTS, help=argparse.SUPPRESS)
    args = parser.parse_args(argv)

    if args.summary:
        if any(value is not None for value in (args.transcript, args.agent_id, args.brief,
                                                args.filled, args.undecided)):
            parser.error("--summary takes no other arguments except --log")
        return summarize(args.log)

    missing = [flag for flag, value in (("--brief", args.brief), ("--filled", args.filled),
                                        ("--undecided", args.undecided)) if value is None]
    if missing:
        parser.error("recording needs " + ", ".join(missing))
    if args.transcript is None and args.agent_id is None:
        parser.error("give a transcript path, --agent-id, or both")
    return record_run(args)


if __name__ == "__main__":
    sys.exit(main())
