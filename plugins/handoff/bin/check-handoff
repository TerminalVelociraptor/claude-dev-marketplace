#!/usr/bin/env python3
"""Check a handoff brief against the structure defined in templates/brief.md.

Covers only what can be checked without judgment: the title and "Written" lines, which sections
are present and in what order, empty sections, plan-step labels, Key files paths, `path:line`
references, likely secrets, and length. Whether the brief is *enough* for a fresh agent is the
brief-reader subagent's job, not this script's.

The template is the single source of truth. Section names, their order, which are optional, which
hold plan steps and their labels, which must list existing paths, and the line target are all read
from it, so changing the template changes this check with no edits here. The template marks these
with comments such as `<!-- check: optional, steps -->` under a section heading.

Exit status: 0 no errors (warnings allowed), 1 errors found, 2 usage or template problem.
"""

import argparse
import os
import re
import sys
from dataclasses import dataclass, field
from pathlib import Path

DEFAULT_TEMPLATE = Path(__file__).resolve().parent.parent / "templates" / "brief.md"

# The template placeholder whose value relative paths in the brief are resolved against.
BASE_DIR_PLACEHOLDER = "working directory"

SECTION_FLAGS = {"optional", "steps", "paths-exist"}
PREAMBLE_FLAGS = {"max-lines"}

COMMENT_RE = re.compile(r"<!--.*?-->", re.DOTALL)
CHECK_RE = re.compile(r"<!--\s*check:(.*?)-->")
PLACEHOLDER_RE = re.compile(r"<([^<>]+)>")
LABEL_RE = re.compile(r"^\*\*([^*]+?):\*\*")
INLINE_CODE_RE = re.compile(r"`([^`\n]+)`")
LIST_PATH_RE = re.compile(r"^- `([^`]+)`")
LINE_REF_RE = re.compile(r"(?P<path>[^\s:`]+):(?P<start>\d+)(?:-(?P<end>\d+))?")
# Outside Key files, `x:12` counts as a line reference only if x looks like a file, so values
# such as `localhost:8080` or `12:30` are left alone.
FILE_LIKE_RE = re.compile(r"/|\.[A-Za-z][A-Za-z0-9]*$")

SECRET_PATTERNS = {
    "API key": re.compile(r"\bsk-[A-Za-z0-9_-]{20,}"),
    "GitHub token": re.compile(r"\b(?:gh[pousr]_[A-Za-z0-9]{30,}|github_pat_[A-Za-z0-9_]{30,})"),
    "AWS access key": re.compile(r"\bAKIA[0-9A-Z]{16}\b"),
    "Slack token": re.compile(r"\bxox[abprs]-[A-Za-z0-9-]{10,}"),
    "private key": re.compile(r"-----BEGIN [A-Z ]*PRIVATE KEY-----"),
}


class TemplateError(Exception):
    pass


@dataclass
class Block:
    """A `## ` section of a Markdown document, or the preamble before the first one."""

    name: str
    line: int
    lines: list = field(default_factory=list)  # (line number, text, inside a code fence)


@dataclass
class Document:
    title: tuple  # (line number, text), or None
    preamble: Block
    sections: list


@dataclass
class SectionRule:
    name: str
    optional: bool = False
    steps: bool = False
    paths_exist: bool = False
    labels: list = field(default_factory=list)


@dataclass
class Template:
    title: str
    preamble: list  # template lines such as "Written <timestamp> from <working directory>."
    sections: list  # SectionRule, in order
    max_lines: int = None


@dataclass
class Finding:
    level: str  # "error" or "warning"
    check: str
    message: str
    line: int = None


def split_document(text):
    """Split Markdown into title, preamble and `## ` sections, ignoring headings in code fences."""
    title = None
    preamble = Block("", 1)
    sections = []
    current = preamble
    in_fence = False
    for number, line in enumerate(text.split("\n"), 1):
        marker = line.lstrip().startswith(("```", "~~~"))
        inside = in_fence or marker
        if marker:
            in_fence = not in_fence
        if not inside:
            if line.startswith("## "):
                current = Block(line[3:].strip(), number)
                sections.append(current)
                continue
            if line.startswith("# ") and title is None and current is preamble:
                title = (number, line)
                continue
        current.lines.append((number, line, inside))
    return Document(title, preamble, sections)


def check_flags(block, allowed, where):
    flags = {}
    for _, line, _ in block.lines:
        for match in CHECK_RE.finditer(line):
            for token in match.group(1).split(","):
                key, _, value = token.strip().partition("=")
                if key:
                    flags[key] = value or True
    unknown = set(flags) - allowed
    if unknown:
        raise TemplateError(f"{where} has unknown check flags: {', '.join(sorted(unknown))}")
    return flags


def load_template(path):
    doc = split_document(Path(path).read_text())
    if doc.title is None:
        raise TemplateError(f"{path}: no '# ' title line")
    if not doc.sections:
        raise TemplateError(f"{path}: no '## ' sections")

    preamble = [COMMENT_RE.sub("", line).strip() for _, line, _ in doc.preamble.lines]
    template = Template(title=doc.title[1], preamble=[line for line in preamble if line], sections=[])

    max_lines = check_flags(doc.preamble, PREAMBLE_FLAGS, f"{path} preamble").get("max-lines")
    if max_lines is not None:
        if not str(max_lines).isdigit():
            raise TemplateError(f"{path}: max-lines must be a number, got {max_lines!r}")
        template.max_lines = int(max_lines)

    for block in doc.sections:
        flags = check_flags(block, SECTION_FLAGS, f"{path} section '{block.name}'")
        rule = SectionRule(
            block.name,
            optional="optional" in flags,
            steps="steps" in flags,
            paths_exist="paths-exist" in flags,
        )
        if rule.steps:
            rule.labels = [m.group(1) for _, line, _ in block.lines if (m := LABEL_RE.match(line))]
            if not rule.labels:
                raise TemplateError(f"{path}: steps section '{block.name}' defines no **Label:** lines")
        template.sections.append(rule)
    return template


def line_pattern(template_line):
    """Regex for a template line: literal text must match, and each <placeholder> captures a value.

    A placeholder that ends the line may contain spaces. Any other captures one word, so the
    literal text after it can still match. Closing punctuation after the last placeholder is
    optional, so "from /dir." and "from /dir (a note)" both capture "/dir".
    """
    parts = PLACEHOLDER_RE.split(template_line)
    regex = ""
    for index, part in enumerate(parts):
        is_last = index == len(parts) - 1
        if index % 2 == 1:
            ends_line = index == len(parts) - 2 and not parts[-1]
            regex += "(.+)" if ends_line else r"(\S+?)"
        elif is_last and index > 0 and part and not re.search(r"\w", part):
            regex += f"(?:{re.escape(part)})?(?=\\s|$)"
        else:
            regex += re.escape(part)
    return re.compile(regex)


def check_reference(ref, number, base_dir, add, always_line_ref=False):
    match = LINE_REF_RE.fullmatch(ref)
    if match and (always_line_ref or FILE_LIKE_RE.search(match.group("path"))):
        path_text = match.group("path")
        start = int(match.group("start"))
        end = int(match.group("end")) if match.group("end") else start
    else:
        path_text, start, end = ref, None, None

    path = Path(os.path.expanduser(path_text))
    if not path.is_absolute():
        if base_dir is None:
            return  # Already reported as a preamble error; guessing a base would bury it.
        path = base_dir / path
    if not path.exists():
        add("missing-path", f"`{ref}`: {path} does not exist", number)
        return
    if start is None:
        return
    if not path.is_file():
        add("line-range", f"`{ref}`: {path} is not a file", number)
        return
    with path.open(errors="replace") as handle:
        total = sum(1 for _ in handle)
    if not 1 <= start <= end <= total:
        add("line-range", f"`{ref}`: {path} has {total} lines", number)


def check_steps(block, rule, add):
    steps = []
    for number, line, inside in block.lines:
        if not inside and line.startswith("### "):
            steps.append((number, line[4:].strip(), []))
        elif steps:
            steps[-1][2].append(line)
    if not steps:
        add("plan-steps", f"'## {block.name}' has no '### ' steps", block.line)
    for number, name, lines in steps:
        body = "\n".join(lines)
        missing = [label for label in rule.labels if f"**{label}:**" not in body]
        if missing:
            labels = ", ".join(f"**{label}:**" for label in missing)
            add("step-labels", f"step '{name}' is missing {labels}", number)


def check_brief(brief_path, template):
    text = Path(brief_path).read_text()
    findings = []

    def add(check, message, line=None, level="error"):
        findings.append(Finding(level, check, message, line))

    # Blank out comments but keep their newlines, so line numbers still match the file.
    stripped = COMMENT_RE.sub(lambda m: "\n" * m.group(0).count("\n"), text)
    doc = split_document(stripped)

    if doc.title is None or not line_pattern(template.title).match(doc.title[1]):
        add("title", f"the first heading should look like: {template.title}",
            doc.title[0] if doc.title else None)

    base_dir = None
    for template_line in template.preamble:
        pattern = line_pattern(template_line)
        names = PLACEHOLDER_RE.findall(template_line)
        found = next((m for _, line, inside in doc.preamble.lines
                      if not inside and (m := pattern.match(line))), None)
        if found is None:
            add("preamble", f"missing a line like: {template_line}")
        elif BASE_DIR_PLACEHOLDER in names:
            value = found.group(names.index(BASE_DIR_PLACEHOLDER) + 1)
            base_dir = Path(os.path.expanduser(value))

    rules = {rule.name: rule for rule in template.sections}
    order = [rule.name for rule in template.sections]
    present = []
    for block in doc.sections:
        if block.name not in rules:
            add("unknown-section", f"'## {block.name}' is not a section in the template", block.line)
        elif any(earlier.name == block.name for earlier in present):
            add("duplicate-section", f"'## {block.name}' appears more than once", block.line)
        else:
            present.append(block)
    for earlier, later in zip(present, present[1:]):
        if order.index(later.name) < order.index(earlier.name):
            add("section-order", f"'## {later.name}' should come before '## {earlier.name}'", later.line)
    present_names = {block.name for block in present}
    for rule in template.sections:
        if not rule.optional and rule.name not in present_names:
            add("missing-section", f"'## {rule.name}' is required")

    checked = set()
    has_steps = False
    for block in present:
        rule = rules[block.name]
        content = [line.strip() for _, line, _ in block.lines if line.strip()]
        if not content:
            add("empty-section", f"'## {block.name}' is empty; write None", block.line)
            continue
        if " ".join(content).rstrip(".") == "None":
            continue
        if rule.steps:
            has_steps = True
            check_steps(block, rule, add)
        if rule.paths_exist:
            for number, line, inside in block.lines:
                if inside or not line.startswith("- "):
                    continue
                match = LIST_PATH_RE.match(line)
                if not match:
                    add("path-format", f"items in '## {block.name}' must start with a path in backticks", number)
                    continue
                check_reference(match.group(1), number, base_dir, add, always_line_ref=True)
                checked.add((number, match.group(1)))

    all_lines = doc.preamble.lines + [entry for block in doc.sections for entry in block.lines]
    for number, line, inside in all_lines:
        if inside:
            continue
        for code in INLINE_CODE_RE.finditer(line):
            ref = code.group(1).strip()
            match = LINE_REF_RE.fullmatch(ref)
            if match and FILE_LIKE_RE.search(match.group("path")) and (number, ref) not in checked:
                check_reference(ref, number, base_dir, add)

    for number, line in enumerate(text.split("\n"), 1):
        for name, pattern in SECRET_PATTERNS.items():
            if pattern.search(line):
                add("secret", f"looks like a {name}; remove it", number)

    total_lines = len(text.splitlines())
    if template.max_lines and total_lines > template.max_lines and not has_steps:
        add("length", f"{total_lines} lines, over the template's target of {template.max_lines} "
            "(only a brief with a plan may run longer)", level="warning")
    return findings


def main(argv=None):
    parser = argparse.ArgumentParser(description="Check a handoff brief against its template.")
    parser.add_argument("brief", type=Path, help="path to the handoff brief")
    parser.add_argument("--template", type=Path, default=DEFAULT_TEMPLATE,
                        help="template to check against (default: the plugin's templates/brief.md)")
    args = parser.parse_args(argv)

    try:
        template = load_template(args.template)
    except (OSError, ValueError, TemplateError) as exc:
        print(f"check-handoff: template problem: {exc}", file=sys.stderr)
        return 2
    try:
        findings = check_brief(args.brief, template)
    except (OSError, ValueError) as exc:
        print(f"check-handoff: {exc}", file=sys.stderr)
        return 2

    for finding in sorted(findings, key=lambda f: f.line or 0):
        where = f"{args.brief}:{finding.line}" if finding.line else str(args.brief)
        print(f"{where}: {finding.level} [{finding.check}] {finding.message}")
    errors = sum(finding.level == "error" for finding in findings)
    warnings = len(findings) - errors
    print(f"{errors} error(s), {warnings} warning(s)" if findings else "OK")
    return 1 if errors else 0


if __name__ == "__main__":
    sys.exit(main())
